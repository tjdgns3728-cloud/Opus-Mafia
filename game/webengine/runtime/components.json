    "unit": "px",
    "min": 0
   },
   "color": {
    "type": "color",
    "default": "#e8e6e1",
    "label": "글자 색"
   },
   "nameColor": {
    "type": "color",
    "default": "#9ec1ff",
    "label": "이름표 색"
   },
   "back": {
    "type": "color",
    "default": "",
    "label": "배경색",
    "help": "비우면 투명"
   },
   "gap": {
    "type": "number",
    "default": 12,
    "label": "줄 사이 간격",
    "unit": "px",
    "min": 0,
    "max": 60
   },
   "follow": {
    "type": "bool",
    "default": true,
