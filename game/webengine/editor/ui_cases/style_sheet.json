{"note": "편집기만으로 스타일 시트: 새 스타일 시트를 만들어 쓰고, 오브젝트에 스타일 이름을 붙이고, 기준점을 '스타일 시트가 정함'으로 → 편집 화면과 실행 화면 모두에 모양이 들어간다. 게임 스타일은 편집기 화면을 바꾸지 않는다.",
 "steps": [
  {"do": "click", "sel": "[data-cmd=\"newProject\"]"}, {"do": "wait", "sel": "#npName"},
  {"do": "set", "sel": "#npName", "value": "UI 스타일"}, {"do": "click", "sel": "#npOk"},
  {"do": "expect", "sel": "#proj", "text": "UI 스타일"},
  {"do": "note", "text": "오브젝트 2개: 상자(스타일 이름 '강조'), 빈 오브젝트(스타일 이름 '띠', 기준점 = 스타일 시트)"},
  {"do": "preset", "name": "상자"}, {"do": "name", "value": "Box"},
  {"do": "set", "sel": "#inspBody [data-n=\"style\"]", "value": "강조"},
  {"do": "click", "sel": "#hierBody"},
  {"do": "preset", "name": "빈 오브젝트"}, {"do": "name", "value": "Band"},
  {"do": "set", "sel": "#inspBody [data-n=\"style\"]", "value": "띠"},
  {"do": "prop", "comp": 0, "key": "anchor", "value": "css"},
  {"do": "note", "text": "스타일 시트 만들기 (📁 파일 › 자원 › ＋ 새 스타일 시트)"},
  {"do": "answer", "value": "화면"}, {"do": "click", "sel": "#newStyle"},
  {"do": "expect", "sel": "#codebar", "text": "스타일 시트"},
  {"do": "code", "text": ":root { font-family: serif; }\n.강조 { box-shadow: rgb(255, 0, 0) 0px 0px 0px 3px; }\n.띠 { position: absolute; left: 10px; right: 10px; bottom: 20px; height: 33px; background: rgb(240, 180, 90); }\n.row { color: rgb(1, 2, 3); }\n"},
  {"do": "expect", "sel": "#codebar", "text": "괄호 짝 맞음"},
  {"do": "click", "sel": "#viewTabs [data-view=\"scene\"]"},
  {"do": "style", "sel": "#sv [data-node$=\"/Box\"]", "prop": "boxShadow", "value": "rgb(255, 0, 0) 0px 0px 0px 3px"},
  {"do": "style", "sel": "#sv [data-node$=\"/Band\"]", "prop": "height", "value": "33px"},
  {"do": "style", "sel": "#sv [data-node$=\"/Band\"]", "prop": "backgroundColor", "value": "rgb(240, 180, 90)"},
  {"do": "note", "text": "게임의 .row 규칙이 편집기 계층 목록(.row)을 바꾸지 않음"},
  {"do": "style", "sel": "#hierBody .row", "prop": "color", "value": "rgb(228, 229, 232)"},
  {"do": "note", "text": "저장 → 실행 화면"},
  {"do": "click", "sel": "#saveBtn"}, {"do": "expect", "sel": "#proj", "text": "저장됨"},
  {"do": "play", "seed": 1},
  {"do": "style", "sel": "[data-node$=\"/Box\"]", "prop": "boxShadow", "value": "rgb(255, 0, 0) 0px 0px 0px 3px", "game": true},
  {"do": "style", "sel": "[data-node$=\"/Band\"]", "prop": "height", "value": "33px", "game": true}
 ]}
